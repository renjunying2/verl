+        base, encoded = name.rsplit(EXPERT_MARKER, 1)
+        if not encoded.isdecimal() or tensor.ndim != 3 or tensor.shape[0] != 1:
+            raise ValueError(f"Invalid streamed Kimi expert: {name}, shape={tuple(tensor.shape)}")
+        expert = int(encoded)
