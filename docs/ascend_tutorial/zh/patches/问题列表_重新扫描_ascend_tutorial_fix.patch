-3.启动训练
-^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
-
-将上述脚本保存为 ``ray_start.sh``, 在 **所有节点** 上分别执行:
+   set -euo pipefail
+
+   : "${MASTER_ADDR:?Set MASTER_ADDR to the head node IPv4 address}"
+   : "${SOCKET_IFNAME:?Set SOCKET_IFNAME to the local communication interface}"
+   : "${DEFAULT_SH:?Set DEFAULT_SH to one existing training script, without wildcards}"
+   NNODES=${NNODES:-2}
+   RAY_PORT=${RAY_PORT:-6766}
+   RAY_DASHBOARD_PORT=${RAY_DASHBOARD_PORT:-8260}
+   RAY_WAIT_TIMEOUT=${RAY_WAIT_TIMEOUT:-300}
+
+   if [[ -n "${CANN_ENV:-}" ]]; then
+       # Some CANN setup scripts reference unset variables.
+       set +u
+       source "$CANN_ENV"
+       set -u
+   fi
+
+   visible_npus=$(python3 - <<'PY'
+   import torch
+   import torch_npu  # noqa: F401
+
+   if not torch.npu.is_available():
+       raise SystemExit("NPU unavailable: check driver/CANN mounts and source set_env.sh")
+   print(torch.npu.device_count())
+   PY
+   )
+   NPUS_PER_NODE=${NPUS_PER_NODE:-$visible_npus}
+   for value in "$NNODES" "$NPUS_PER_NODE" "$RAY_PORT" "$RAY_DASHBOARD_PORT" "$RAY_WAIT_TIMEOUT"; do
+       if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
+           echo "Node/device counts, ports and timeout must be positive integers: $value" >&2
+           exit 1
+       fi
+   done
+   if (( NPUS_PER_NODE > visible_npus )); then
+       echo "Requested $NPUS_PER_NODE NPUs, but only $visible_npus logical devices are visible" >&2
+       exit 1
+   fi
+   if [[ ! -f "$DEFAULT_SH" ]]; then
+       echo "Training script does not exist: $DEFAULT_SH (use one explicit path)" >&2
+       exit 1
+   fi
+
+   interface_info=$(ip -o -4 addr show dev "$SOCKET_IFNAME" scope global)
+   if [[ -z "$interface_info" ]]; then
+       echo "No IPv4 address on interface $SOCKET_IFNAME" >&2
+       exit 1
+   fi
+   CURRENT_IP=${CURRENT_IP:-$(awk 'NR == 1 {split($4, a, "/"); print a[1]}' <<< "$interface_info")}
+   if ! awk -v selected="$CURRENT_IP" '{split($4, a, "/"); if (a[1] == selected) found = 1} END {exit !found}' <<< "$interface_info"; then
+       echo "CURRENT_IP=$CURRENT_IP does not belong to $SOCKET_IFNAME" >&2
+       exit 1
+   fi
+   export HCCL_SOCKET_IFNAME="$SOCKET_IFNAME"
+   export GLOO_SOCKET_IFNAME="$SOCKET_IFNAME"
+   export NNODES NPUS_PER_NODE MASTER_ADDR CURRENT_IP RAY_WAIT_TIMEOUT
+   export NDEVICES_PER_NODE="$NPUS_PER_NODE"
+
+   # Refuse to disrupt an existing local Ray instance. Stop only a previous
+   # instance owned by this job, in its dedicated environment, before retrying.
+   if ray status --address=auto >/dev/null 2>&1; then
+       echo "A local Ray instance already exists; use a fresh job environment" >&2
+       exit 1
+   fi
+   export RAY_ADDRESS="${MASTER_ADDR}:${RAY_PORT}"
+   ray_args=(--node-ip-address="$CURRENT_IP" --resources="{\"NPU\": $NPUS_PER_NODE}")
+
+   if [[ "$MASTER_ADDR" == "$CURRENT_IP" ]]; then
+       timeout "$RAY_WAIT_TIMEOUT" ray start --head --port="$RAY_PORT" \
+           --dashboard-host="$MASTER_ADDR" --dashboard-port="$RAY_DASHBOARD_PORT" "${ray_args[@]}"
+
+       # Query structured resources instead of parsing Ray's human-readable status.
+       timeout "$RAY_WAIT_TIMEOUT" python3 - <<'PY'
+   import os
+   import time
+
+   import ray
+
+   ray.init(address=os.environ["RAY_ADDRESS"], logging_level="ERROR")
+   expected_nodes = int(os.environ["NNODES"])
+   devices_per_node = int(os.environ["NPUS_PER_NODE"])
+   deadline = time.monotonic() + int(os.environ.get("RAY_WAIT_TIMEOUT", "300"))
+   while time.monotonic() < deadline:
+       nodes = [n for n in ray.nodes() if n["Alive"] and n["Resources"].get("NPU", 0) > 0]
+       if len(nodes) == expected_nodes and all(n["Resources"]["NPU"] >= devices_per_node for n in nodes):
+           print(f"Ray ready: {len(nodes)} nodes, at least {devices_per_node} NPUs per node", flush=True)
+           ray.shutdown()
+           break
+       print(f"Waiting for {expected_nodes} NPU nodes; currently {len(nodes)}", flush=True)
+       time.sleep(5)
+   else:
+       ray.shutdown()
+       raise SystemExit("Timed out waiting for the expected Ray NPU nodes")
+   PY
+       ray status --address="$RAY_ADDRESS"
+       exec bash "$DEFAULT_SH" "$@"
+   else
+       deadline=$((SECONDS + RAY_WAIT_TIMEOUT))
+       until timeout 3 bash -c 'exec 3<>/dev/tcp/"$1"/"$2"' _ "$MASTER_ADDR" "$RAY_PORT" 2>/dev/null; do
+           if (( SECONDS >= deadline )); then
+               echo "Timed out connecting to $RAY_ADDRESS; check head startup and firewall ports" >&2
+               exit 1
+           fi
+           sleep 2
+       done
+       remaining=$((deadline - SECONDS))
+       if (( remaining <= 0 )); then
+           echo "Timed out before Ray worker registration" >&2
+           exit 1
+       fi
+       timeout "$remaining" ray start --address="$RAY_ADDRESS" "${ray_args[@]}"
+       echo "Worker registered at $RAY_ADDRESS; Ray daemons continue running"
+   fi
+
+
+执行训练
+--------
 
 .. code-block:: bash
 
-  bash ray_start.sh
+   mkdir -p logs
+   set -o pipefail
+   bash ray_start.sh 2>&1 | tee logs/ray_start.log
 
-执行顺序建议：
+先在 head 节点执行，再在所有 worker 节点执行。仅当恰好有 ``NNODES`` 个存活 NPU 节点且每个至少提供 ``NPUS_PER_NODE`` 个资源时，head 才启动训练。训练在前台运行并传递退出码；注册或资源等待会在 ``RAY_WAIT_TIMEOUT`` 秒后失败。worker 脚本注册后返回，Ray 守护进程继续运行，训练期间需保持 worker 容器或作业分配存活。
 
-1. 先在 **主节点** 上启动脚本, 等待 Ray Head 服务就绪
-2. 再在各个 **子节点** 上启动脚本, 子节点会自动向主节点注册
-3. 主节点检测到所有节点加入后, 自动触发训练任务
+使用新的专用任务环境；若本任务上次运行的 Ray 仍存在，先在其容器内用 ``ray stop`` 停止，再重新启动。不要终止所有 Python 进程，也不要删除共享的 ``/tmp/ray``。``ray stop`` 是清理操作，无需将已有集群作为其执行前提。
 
